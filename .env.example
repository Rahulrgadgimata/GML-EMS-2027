# =============================================================================
#  GM League Season 4 — environment configuration
#  Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# =============================================================================

# ------------------------------- Security ------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Admin console credentials. CHANGE THESE before the event.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Optional and safer: store a hash instead of the plain password. Generate with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
# When set, ADMIN_PASSWORD is ignored.
ADMIN_PASSWORD_HASH=

# ------------------------------- Branding ------------------------------------
LEAGUE_NAME=GM League Season 4
LEAGUE_SHORT=GML S4
LEAGUE_SEASON=Season 4
LEAGUE_UNIVERSITY=GM University
LEAGUE_TAGLINE=Season 4 — Where Legends Are Born
SITE_URL=http://127.0.0.1:5000
SUPPORT_PHONE=6363962653
SUPPORT_PHONE_ALT=7019670142
SUPPORT_EMAIL=

# WhatsApp helpline — shown as a floating "Any doubts?" button and in every email.
WHATSAPP_NUMBER=8618139789
WHATSAPP_COUNTRY_CODE=91

# --- "All the best" sign-off shown at the end of every automated email -------
DIRECTOR_NAME=Ajjaiah G B
DIRECTOR_TITLE=Director — PE
DIRECTOR_MESSAGE=Play hard, play fair, and enjoy every minute of it. The whole Physical Education department is behind you this season — go make it count.

# ------------------------- SMTP / email automation ---------------------------
# Master switch. Set to false to turn every automated email off.
MAIL_ENABLED=true
# Set to true to write .eml files into ./outbox instead of sending (dry run).
# This also happens automatically while MAIL_USERNAME/MAIL_PASSWORD are empty.
MAIL_SUPPRESS_SEND=false

# --- Gmail (recommended: use an App Password, NOT your normal password) ---
#   Google Account → Security → 2-Step Verification → App passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# --- Outlook / Office 365 ---
#   MAIL_SERVER=smtp.office365.com   MAIL_PORT=587   MAIL_USE_TLS=true
# --- Zoho ---
#   MAIL_SERVER=smtp.zoho.in         MAIL_PORT=465   MAIL_USE_SSL=true  MAIL_USE_TLS=false
# --- Brevo / SendinBlue ---
#   MAIL_SERVER=smtp-relay.brevo.com MAIL_PORT=587   MAIL_USE_TLS=true

MAIL_USERNAME=
MAIL_PASSWORD=

# What recipients see in the "From" line.
MAIL_SENDER_NAME=GM League Season 4
MAIL_SENDER_EMAIL=
# Optional: where replies should go, and a silent copy of every mail.
MAIL_REPLY_TO=
MAIL_ADMIN_BCC=

# The emblem embedded in every email (looked up in static/logos/).
MAIL_LOGO_FILE=gmulogo1.png

MAIL_TIMEOUT=20
MAIL_MAX_RETRIES=2
MAIL_WORKERS=2

# ------------------------------- League rules --------------------------------
DEFAULT_TEAM_BUDGET=1000000
MAX_UPLOAD_MB=8

# ------------------------------- Runtime -------------------------------------
DATABASE_URL=sqlite:///league.db
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true
# Set to true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
